# Runtime image consumes only these inputs, including CI-downloaded binaries.
**
!Dockerfile
!.dockerignore
!start.sh
!skills/
!skills/**
!dist/
dist/**
!dist/amd64/
dist/amd64/**
!dist/amd64/artex
!dist/arm64/
dist/arm64/**
!dist/arm64/artex

# Keep local credentials and runtime/cache state out even inside allowed trees.
**/.git
**/.env
**/.env.*
**/config.json
**/jwt.key
**/data
**/sessions
**/transcripts
**/node_modules
**/.cache
**/__pycache__
**/.playwright-mcp
**/.playwright-cli
**/*.db
**/*.db-wal
**/*.db-shm
**/*.pyc
