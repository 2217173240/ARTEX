# Docker 部署配置（复制为 .env）
ARTEX_IMAGE=ghcr.io/2217173240/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# 密码含 URL 特殊字符时填写完整、百分号编码的连接串；install.sh 会自动生成。
ARTEX_PG_DSN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# 单次模型调用秒数（包含重试与流式等待）；0 关闭，父任务取消仍生效。
ARTEX_LLM_CALL_TIMEOUT=600
